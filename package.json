{
  "name": "apologiasancta-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "types": "tsc --noEmit",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types tests/phase3.test.ts tests/phase3-security.test.ts tests/phase4a.test.ts tests/answer-submission.test.ts tests/auth-integrity.test.ts tests/operational-platform.test.ts tests/unified-redesign.test.ts tests/android-workflows.test.ts tests/phase3-curriculum-blueprint.test.mjs tests/phase4-content-production.test.mjs src/lib/batchImportUtils.test.ts",
    "curriculum:generate": "node scripts/generate-phase3-curriculum.mjs",
    "curriculum:validate": "node scripts/validate-phase3-curriculum.mjs",
    "curriculum:check": "npm run curriculum:generate && npm run curriculum:validate",
    "content:generate": "node scripts/generate-phase4-content.mjs",
    "content:validate": "node scripts/validate-phase4-content.mjs",
    "content:verify-citations": "node scripts/verify-phase4-citations.mjs --write",
    "content:check": "npm run curriculum:validate && npm run content:generate && npm run content:validate",
    "test:vitest": "vitest run",
    "test:editorial-database": "tsc -p tsconfig.editorial-database.json --noEmit && vitest run --config vitest.editorial-database.config.ts",
    "test:e2e": "npx --yes @playwright/test@1.61.1 test",
    "cap:sync": "cap sync android",
    "cap:add:android": "cap add android",
    "cap:open:android": "cap open android",
    "apk:sync": "node scripts/sync-latest-apk.cjs",
    "apk:release": "node scripts/build-release-apk.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.2",
    "framer-motion": "^12.40.0",
    "mysql2": "^3.15.3",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18"
    }
  }
}
