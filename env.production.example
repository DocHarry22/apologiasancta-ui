# Copy these values into the production host dashboard.
# Do not commit real secrets in .env*.local files.

NEXT_PUBLIC_ENGINE_URL=https://apologiasancta-engine.onrender.com
ENGINE_INTERNAL_URL=https://apologiasancta-engine.onrender.com
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
CAPACITOR_SERVER_URL=https://your-production-domain.example
NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/DocHarry22/apologiasancta-ui/releases/latest/download/apologia-sancta.apk
NEXT_PUBLIC_AUTHOR_ENABLED=true

# Admin sign-in
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-rotated-admin-password
ADMIN_DISPLAY_NAME=Admin
ADMIN_ROLE=super_admin
AUTHOR_SESSION_SECRET=replace-with-rotated-session-secret

# Signup policy
# Public signup creates viewer accounts by default.
# To allow staff-capable signup, provide an invite code and choose a safe role.
# These values are fallback defaults and can be overridden in the dashboard Settings UI.
AUTH_SIGNUP_STAFF_INVITE_CODE=replace-with-staff-invite-code
AUTH_SIGNUP_STAFF_ROLE=host

# MySQL/MariaDB admin-user database. Prefer DATABASE_URL when available.
DATABASE_URL=mysql://user:password@host:3306/database
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
# Optional, temporary only. Remove after inspecting /api/auth/diagnostics.
# AUTH_DIAGNOSTICS_ENABLED=true
# DB_CONNECT_TIMEOUT_MS=10000

ADMIN_TOKEN=replace-with-render-admin-token
