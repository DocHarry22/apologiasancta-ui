# Copy these values into the production host dashboard.
# Do not commit real secrets in .env*.local files.

NEXT_PUBLIC_ENGINE_URL=https://apologiasancta-engine.onrender.com
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
CAPACITOR_SERVER_URL=https://your-production-domain.example
NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/DocHarry22/apologiasancta-ui/releases/latest/download/apologia-sancta.apk
NEXT_PUBLIC_AUTHOR_ENABLED=true

AUTHOR_ADMIN_PASSWORD=replace-with-rotated-password
AUTHOR_SESSION_SECRET=replace-with-rotated-session-secret
ADMIN_TOKEN=replace-with-render-admin-token
