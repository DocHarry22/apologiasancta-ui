# Browser-safe URLs
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RESEARCH_GRAPH_URL=
NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/DocHarry22/apologiasancta-ui/releases/latest/download/apologia-sancta.apk
NEXT_PUBLIC_AUTHOR_ENABLED=true

# Server-to-server engine access. Must match the Engine's ADMIN_TOKEN.
ENGINE_INTERNAL_URL=http://localhost:4000
ENGINE_ADMIN_TOKEN=

# Account-linked live-player identity. Keep the secret server-only and use the
# same dedicated 32+ byte random value on the Engine. Do not reuse join/admin/
# session secrets or prefix this variable with NEXT_PUBLIC_. Keep disabled
# until both providers are configured and ENGINE_INTERNAL_URL uses HTTPS in
# production.
ACCOUNT_IDENTITY_ENABLED=false
ACCOUNT_IDENTITY_SECRET=
ACCOUNT_IDENTITY_ISSUER=apologia-ui
ACCOUNT_IDENTITY_ASSERTION_TTL_SECONDS=120

# Staff authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=Admin
ADMIN_ROLE=super_admin
AUTHOR_SESSION_SECRET=replace-with-at-least-32-random-bytes
# PostgreSQL staff credentials live outside exposed schemas. Enable bootstrap
# only for the first controlled provisioning run, then remove/disable it.
ADMIN_DB_SCHEMA=private
ADMIN_BOOTSTRAP_ENABLED=false
AUTH_SIGNUP_STAFF_INVITE_CODE=replace-with-a-random-invite-code
AUTH_SIGNUP_STAFF_ROLE=host

# Durable staff, workflow, audit, and progress-adjacent server records.
DATABASE_URL=postgresql://user:password@localhost:5432/apologiasancta
APP_STORAGE_DRIVER=database

# Human-reviewed theological publishing. Direct Engine import remains off
# unless a super-admin deliberately enables the audited emergency bypass.
EDITORIAL_EMERGENCY_IMPORT_ENABLED=false
EDITORIAL_PUBLISH_LEASE_SECONDS=90
EDITORIAL_ENGINE_TIMEOUT_MS=20000

# Canonical learning/content database. Use the dedicated Supabase PostgreSQL
# connection string; never expose it through NEXT_PUBLIC_* variables.
LEARNING_DATABASE_URL=postgresql://postgres.project-ref:password@pooler.region.supabase.com:6543/postgres
LEARNING_DB_SSL_MODE=require
LEARNING_DB_CONNECT_TIMEOUT_MS=10000
LEARNING_DB_STATEMENT_TIMEOUT_MS=15000

# Shared only with the Render engine. Rotate independently of admin, learner,
# join-token, and session secrets.
CONTENT_API_TOKEN=

# Android wrapper
CAPACITOR_SERVER_URL=http://localhost:3000

# Autonomous Catholic research agent. Server-only credentials.
# Install private tables with: npm run agent:migrate
# Hourly scheduled calls process up to six topics/day by default.
OPENAI_API_KEY=
CONTENT_AGENT_MODEL=gpt-6-sol
CONTENT_AGENT_CRON_SECRET=
CONTENT_AGENT_ENABLED=true
CONTENT_AGENT_DAILY_LIMIT=6
# Scheduler: GitHub repository variable CONTENT_AGENT_APP_URL (HTTPS app URL),
# and repository secret CONTENT_AGENT_CRON_SECRET (same random 32+ character value).

# Optional subscription mode: private worker signed in using `codex login`.
# Never copy Codex auth.json or OAuth credentials into this repository/site/CI.
CONTENT_AGENT_PROVIDER=codex
CONTENT_AGENT_CODEX_BIN=codex
CONTENT_AGENT_CODEX_MODEL=
# Run npm run agent:worker on a private host, with LEARNING_DATABASE_URL set.
# The worker uses its own native Codex session; no OPENAI_API_KEY is required.
