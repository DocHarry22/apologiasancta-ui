# Browser-safe URLs
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RESEARCH_GRAPH_URL=
NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/DocHarry22/apologiasancta-ui/releases/latest/download/apologia-sancta.apk
NEXT_PUBLIC_AUTHOR_ENABLED=true

# Server-to-server engine access. Must match the Engine's ADMIN_TOKEN.
ENGINE_INTERNAL_URL=http://localhost:4000
ENGINE_ADMIN_TOKEN=

# Staff authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=Admin
ADMIN_ROLE=super_admin
AUTHOR_SESSION_SECRET=replace-with-at-least-32-random-bytes
AUTH_SIGNUP_STAFF_INVITE_CODE=replace-with-a-random-invite-code
AUTH_SIGNUP_STAFF_ROLE=host

# Durable staff, workflow, audit, and progress-adjacent server records.
DATABASE_URL=postgresql://user:password@localhost:5432/apologiasancta

# Android wrapper
CAPACITOR_SERVER_URL=http://localhost:3000
